# Copy to .env and fill in. Never commit real values.
# Local database (see docker-compose.yml). For production use your managed Postgres URL.
DATABASE_URL="postgresql://lisva:lisva_dev_password@localhost:5432/lisva?schema=public"
# Separate database used only by automated tests.
DATABASE_URL_TEST="postgresql://lisva:lisva_dev_password@localhost:5432/lisva_test?schema=public"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram alert for every new order. Leave empty to skip alerts (orders are still saved).
#  1. In Telegram, talk to @BotFather, send /newbot and copy the token it gives you.
#  2. Open a chat with your new bot and send it any message.
#  3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...} (a number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for testing against a fake Telegram server. Leave empty in real use.
TELEGRAM_API_BASE_URL=

# Product pictures uploaded in the admin. With the three Cloudinary settings, the server uploads each picture to
# Cloudinary and the database keeps only its https address. Find them in the Cloudinary dashboard
# (Settings > API Keys). The API secret stays on the server; never put it in a NEXT_PUBLIC_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder in your Cloudinary library (default lisva/products)
CLOUDINARY_FOLDER=
# Only for testing against a fake server. Leave empty in real use.
CLOUDINARY_API_BASE_URL=
# Without Cloudinary, pictures are saved in this folder (default: .uploads in the project). Good for development
# and a server you manage; a host with a temporary disk needs Cloudinary.
UPLOAD_DIR=
# Pictures linked from other websites are shown only for these hosts (comma separated), e.g. cdn.example.com
IMAGE_HOSTS=

# Optional: fills English fields the owner leaves empty in the admin by translating the Vietnamese (DeepL API).
# Get a free key at https://www.deepl.com/pro-api (keys of the free plan end with ":fx"). Without a key, English
# must be typed. Only product and category texts are sent, never customer data.
DEEPL_API_KEY=
# Defaults: source VI, target EN-US. Change only if DeepL asks for different codes.
DEEPL_SOURCE_LANG=
DEEPL_TARGET_LANG=
# Only for testing against a fake server. Leave empty in real use.
DEEPL_API_BASE_URL=
