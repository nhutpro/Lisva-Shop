# Copy to .env and fill in. Never commit real values.
# Local database (see docker-compose.yml). For production use your managed Postgres URL.
DATABASE_URL="postgresql://lisva:lisva_dev_password@localhost:5432/lisva?schema=public"
# Separate database used only by automated tests.
DATABASE_URL_TEST="postgresql://lisva:lisva_dev_password@localhost:5432/lisva_test?schema=public"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram alert for every new order. Leave empty to skip alerts (orders are still saved).
#  1. In Telegram, talk to @BotFather, send /newbot and copy the token it gives you.
#  2. Open a chat with your new bot and send it any message.
#  3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...} (a number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for testing against a fake Telegram server. Leave empty in real use.
TELEGRAM_API_BASE_URL=
